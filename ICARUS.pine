//@version=6

// Version
string VERSION = "V1"
indicator("ICARUS " + VERSION, overlay = true, max_labels_count = 300)

// By: @dmandrey
//
// ICARUS trades the failure of an already-extended trend: a three-state
// sequence (TRENDING -> BREAK -> CONFIRM) fires only on confirmation, never
// on the break itself. Inverted premise vs. SuperLazyTrade: there, extension
// is a penalty; here it is a prerequisite.
//
// These methodologies are educational references and do not guarantee any
// specific trading results.

//======================================================================
// CONSTANTS
//======================================================================
const string DASH_WIDTH = "                                        "
const int DASHBOARD_MAX_ROWS = 24

//======================================================================
// TYPES
//======================================================================
// Pine arrays cannot nest (no array<array<float>>), so a completed
// session's per-slot volume history is wrapped in a UDT — same pattern
// SuperLazyTrade uses for its Time-of-Day RVOL block.
type TodSession
    array<float> vols

//======================================================================
// INPUTS
//======================================================================
grp_setup = "🎯 Reversal Setup"
swingLookback = input.int(5, "Swing Pivot Strength", minval = 2, maxval = 15, group = grp_setup,
     tooltip = "Bars required on each side of a bar before its high/low is confirmed as a swing.")
trendMinBars = input.int(8, "Min Bars in Trend", minval = 5, maxval = 100, group = grp_setup, // TEMP: was 20, loosened for signal-frequency debugging
     tooltip = "Minimum bars the qualifying structure must hold before a trend is eligible to break.")
confirmMaxBars = input.int(8, "Max Bars to Confirm Break", minval = 2, maxval = 20, group = grp_setup,
     tooltip = "Bars allowed between a structure break and its confirmation. If exceeded, the armed break " +
               "is cancelled — treated as consolidation/trend-resumption, not a reversal.")
requireCloseBreak = input.bool(true, "Require Close Beyond Swing (not just wick)", group = grp_setup,
     tooltip = "ON: structure break requires a confirmed bar's close beyond the prior swing. " +
               "OFF: a wick beyond the swing is sufficient.")
rangeAnchor = input.string("RTH", "Session Range Anchor", options = ["RTH", "Full Session"], group = grp_setup,
     tooltip = "RTH (default): session open/high/low and VWAP anchor to the 09:30 ET open. Required for " +
               "correct extension math on futures — a calendar-day anchor drags in the overnight range and " +
               "inflates extension at 09:35.\n\n" +
               "Full Session: calendar-day anchor, for 24h instruments running with Time Gates disabled. " +
               "Untested — extension figures under this mode are not comparable to RTH-anchored ones.")
minTickStop = input.int(0, "Min Stop Distance (ticks, 0 = off)", minval = 0, maxval = 200, group = grp_setup,
     tooltip = "Floors the ATR-based stop distance at this many ticks beyond entry. Prevents an unfillable " +
               "stop on thin futures contracts where an 0.8 ATR stop can land inside the spread.")

grp_veto = "🛑 Vetoes"
useTrendDayLockout = input.bool(true, "Trend-Day Lockout", group = grp_veto,
     tooltip = "Session-level latch: once a trend day is detected, blocks reversal signals against that " +
               "trend for the remainder of the session.")
useHtfVeto = input.bool(true, "HTF Veto", group = grp_veto,
     tooltip = "Hard veto (not a score penalty): blocks a reversal signal when the higher-timeframe EMA9/" +
               "EMA20 trend still agrees with the trend being faded.")
htfTimeframe = input.timeframe("15", "HTF Timeframe", group = grp_veto)
useTimeGates = input.bool(true, "Time-of-Day Gates", group = grp_veto,
     tooltip = "Blocks entries in the first/last N minutes of RTH (0930-1600 ET). Hardcoded to ET — " +
               "disable for crypto / 24h futures.")
noEntryOpenMins = input.int(15, "No Entry — First N Minutes", minval = 0, maxval = 60, group = grp_veto)
noEntryCloseMins = input.int(15, "No Entry — Last N Minutes", minval = 0, maxval = 60, group = grp_veto)

grp_exit = "📐 Exits"
stopAtrMult = input.float(0.8, "Stop (ATR mult beyond invalidation)", minval = 0.2, maxval = 3.0, step = 0.1, group = grp_exit)
target2Mode = input.string("Session Open", "Target 2", options = ["Session Open", "EMA50", "Fixed R"], group = grp_exit)
target2R = input.float(3.0, "Target 2 (R multiple)", minval = 1.0, maxval = 10.0, step = 0.5, group = grp_exit)
timeStopBars = input.int(40, "Time Stop (bars)", minval = 0, maxval = 200, group = grp_exit)

grp_rvol = "📊 Relative Volume"
rvolMode = input.string("Time-of-Day", "Relative Volume Mode", options = ["Rolling 20-bar", "Time-of-Day"], group = grp_rvol,
     tooltip = "TIME-OF-DAY (default): compares bar volume to the same intraday bar-slot's average across " +
               "prior RVOL Lookback Sessions. Falls back to Rolling 20-bar when fewer than 3 sessions exist " +
               "at that slot. The break-bar RVOL test is the core discriminator between a real break and a " +
               "pullback, so removing the intraday U-shaped volume bias matters here.")
rvolLookbackDays = input.int(10, "RVOL Lookback Sessions", minval = 3, maxval = 20, group = grp_rvol)

grp_vis = "Dashboard & Visuals"
showDash = input.bool(true, "Show Dashboard", group = grp_vis)
extDash = input.bool(true, "Extended Metrics", group = grp_vis)
showState = input.bool(true, "Show State Machine Markers", group = grp_vis)
showLevels = input.bool(true, "Show Swing / Invalidation Levels", group = grp_vis)

//======================================================================
// ASSET PROFILE ASSIGNMENT
//======================================================================
// Same two-step pattern as SuperLazyTrade: a switch on syminfo.type first
// computes asset_category (default => MARKET, the true catch-all for
// index/forex/unknown), then an if/else-if chain keyed on asset_category
// sets profile_name and every threshold used downstream. No 'var' — these
// reassign every bar.
string asset_category = switch syminfo.type
    "stock"   => "STOCK"
    "fund"    => "FUND"
    "futures" => "FUTURES"
    "crypto"  => "CRYPTO"
    =>           "MARKET" // Fallback for Index, Forex, or Unknown

float ext_min        = 2.0   // Min session extension (daily-ATR units) to qualify a trend as worth unwinding
float atr_break_mult = 1.3   // Break bar's range must exceed this x ATR(14) to count as violent
float rvol_break     = 1.8   // Min RVOL required on the break bar
float adx_trend_min  = 25.0  // Min ADX for State 1 (trend qualification)
float retrace_min    = 0.20  // Actionable retracement window, fraction of session range (below = noise)
float retrace_max    = 0.55  // Above this = move already spent, missed
string profile_name  = "MARKET INDEX 🏦"

if asset_category == "MARKET"
    profile_name := "MARKET INDEX 🏦"
    ext_min := 2.0
    atr_break_mult := 1.3
    rvol_break := 1.8
    adx_trend_min := 25.0
    retrace_min := 0.20
    retrace_max := 0.55

else if asset_category == "FUND"
    profile_name := "ETF / FUND 📊"
    ext_min := 2.2
    atr_break_mult := 1.4
    rvol_break := 2.0
    adx_trend_min := 18.0
    retrace_min := 0.25
    retrace_max := 0.55

else if asset_category == "STOCK"
    profile_name := "STOCK 🚀"
    // TEMP: loosened from ext_min=3.0, atr_break_mult=1.5, rvol_break=2.2,
    // adx_trend_min=20.0, retrace_min=0.25, retrace_max=0.50 for signal-
    // frequency debugging — revert once confirmed the pipeline fires end-to-end.
    ext_min := 1.5
    atr_break_mult := 1.1
    rvol_break := 1.3
    adx_trend_min := 12.0
    retrace_min := 0.15
    retrace_max := 0.65

else if asset_category == "FUTURES"
    profile_name := "FUTURES ⚡"
    ext_min := 2.5
    atr_break_mult := 1.4
    rvol_break := 1.8
    adx_trend_min := 15.0
    retrace_min := 0.25
    retrace_max := 0.55

else if asset_category == "CRYPTO"
    profile_name := "CRYPTO 🪙"
    ext_min := 4.0
    atr_break_mult := 1.6
    rvol_break := 2.0
    adx_trend_min := 28.0
    retrace_min := 0.30
    retrace_max := 0.60

else
    profile_name := "MARKET INDEX 🏦" // Defensive fallback; asset_category is exhaustive over the switch above

//======================================================================
// CORE INDICATOR CALCULATIONS
//======================================================================
ema9  = ta.ema(close, 9)
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)

atr = ta.atr(14)
rsiVal = ta.rsi(close, 14)
[_, _, adx] = ta.dmi(14, 14)

bool adx_rising_3 = ta.rising(adx, 3) // reserved for Phase 5 (Trend-Day Lockout / velocity check)

// Daily ATR — lookahead_off avoids future-bar repaint; this is display-only
// intrabar (reads the developing daily bar's live value), same caveat as
// SuperLazyTrade's atr_14. No signal in this system fires from it directly
// without barstate.isconfirmed downstream.
float atr_daily = request.security(syminfo.tickerid, "D", ta.atr(14), lookahead = barmerge.lookahead_off)

//======================================================================
// SESSION ANCHORING
//======================================================================
// NOT the same as SuperLazyTrade's calendar-day anchor. Every downstream
// measurement (extension gate, retracement, VWAP target, trend-day lockout)
// is denominated against session_open_price / session_high / session_low,
// so the anchor must be the 09:30 ET RTH open, not the overnight/midnight
// print — otherwise futures show 2-3 ATR of phantom "extension" built
// entirely in Asian/European hours. See ICARUS_CLAUDE.md for detail.
var float session_open_price = na
var float session_high = na
var float session_low = na
var int session_open_time = na

bool rth_active = not na(time(timeframe.period, "0930-1600:23456"))
// barstate.isfirst covers bar 0 / start-of-history, where there is no
// prior bar to compare against but the session must still initialize.
// (na() on a series bool doesn't resolve cleanly in Pine's overloads.)
bool is_new_range_rth = rth_active and (barstate.isfirst or not rth_active[1])
bool is_new_range_full = ta.change(time("D")) != 0 or na(session_high[1])
bool is_new_range = rangeAnchor == "RTH" ? is_new_range_rth : is_new_range_full
bool range_active = rangeAnchor == "RTH" ? rth_active : true

if is_new_range
    session_open_price := open
    session_high := high
    session_low := low
    session_open_time := time
else if range_active
    session_high := math.max(session_high, high)
    session_low := math.min(session_low, low)
// else: outside the active range (RTH mode only) — hold prior values

float session_range = not na(session_high) and not na(session_low) ? session_high - session_low : 0.0

//======================================================================
// RTH-ANCHORED VWAP
//======================================================================
// ta.vwap() anchors to the exchange session, which begins at the overnight
// open on futures — that drags Target 1 (VWAP) to the wrong price. Instead,
// accumulate price*volume / volume manually, reset on the same is_new_range
// boundary as the session high/low above, so VWAP and the extension gate
// always agree on what "this session" means.
var float cum_pv = 0.0
var float cum_vol = 0.0

if is_new_range
    cum_pv := close * volume
    cum_vol := volume
else if range_active
    cum_pv += close * volume
    cum_vol += volume

float anchored_vwap = cum_vol > 0 ? cum_pv / cum_vol : na

//======================================================================
// TIME-OF-DAY RELATIVE VOLUME
//======================================================================
// Ported from SuperLazyTrade's TodSession block, with one deliberate
// adaptation: the session boundary is is_new_range (this system's
// RTH-anchored session) rather than SLT's calendar-day change, and slot
// accumulation is gated by range_active so overnight bars in RTH mode
// never occupy a bar-slot — otherwise slot indices would drift and the
// break-bar RVOL test (the core discriminator in Phase 3) would compare
// against the wrong slot.
var array<TodSession> tod_vol_history = array.new<TodSession>()
var TodSession tod_current_session = TodSession.new(array.new<float>())
var int tod_slot_idx = 0

if is_new_range
    // Finalize the just-completed session into history (skip empty first run)
    if array.size(tod_current_session.vols) > 0
        array.push(tod_vol_history, tod_current_session)
        if array.size(tod_vol_history) > rvolLookbackDays
            array.shift(tod_vol_history)
    tod_current_session := TodSession.new(array.new<float>())
    tod_slot_idx := 0

float rel_vol_tod = na

if range_active
    array.push(tod_current_session.vols, volume)

    float tod_vol_sum = 0.0
    int tod_vol_count = 0
    int tod_hist_sessions = array.size(tod_vol_history)
    if tod_hist_sessions > 0
        for s = 0 to tod_hist_sessions - 1
            TodSession tod_sess = array.get(tod_vol_history, s)
            if tod_slot_idx < array.size(tod_sess.vols)
                tod_vol_sum += array.get(tod_sess.vols, tod_slot_idx)
                tod_vol_count += 1

    // Require at least 3 historical sessions at this slot for a meaningful average
    bool tod_data_sufficient = tod_vol_count >= 3
    float tod_vol_avg = tod_data_sufficient ? tod_vol_sum / tod_vol_count : na
    rel_vol_tod := tod_data_sufficient and not na(tod_vol_avg) and tod_vol_avg > 0 ? volume / tod_vol_avg : na

    tod_slot_idx += 1

// Relative Volume: Rolling 20-bar (always computed, used as fallback) +
// Time-of-Day (used when selected and sufficient history exists)
vol_ma20 = ta.sma(volume, 20)
float rel_vol_rolling = vol_ma20 > 0 ? volume / vol_ma20 : 1.0

bool tod_rvol_active = rvolMode == "Time-of-Day" and not na(rel_vol_tod)
float rel_vol = tod_rvol_active ? rel_vol_tod : rel_vol_rolling
string rvol_mode_label = tod_rvol_active ? "TOD" : (rvolMode == "Time-of-Day" ? "20-bar*" : "20-bar")

//======================================================================
// NON-REPAINTING SWING STRUCTURE
//======================================================================
// A swing high/low needs `swingLookback` bars of hindsight on its right
// side before it can be confirmed. ta.pivothigh/ta.pivotlow are banned for
// signal logic (rule 2) — they carry this exact same lookback but hide it
// behind the function call, which invites accidentally reading a swing
// that isn't confirmed yet. Instead the pivot test is done explicitly
// against high[swingLookback] / low[swingLookback], and state is only
// latched when barstate.isconfirmed — so the swing at absolute bar
// (bar_index - swingLookback) becomes visible to any downstream logic
// only `swingLookback` bars after it printed, never sooner, in both live
// and historical replay.
var float last_swing_high = na
var int   last_swing_high_bar = na
var float prev_swing_high = na
var int   prev_swing_high_bar = na

var float last_swing_low = na
var int   last_swing_low_bar = na
var float prev_swing_low = na
var int   prev_swing_low_bar = na

bool swing_window_ready = bar_index >= (2 * swingLookback)

if barstate.isconfirmed and swing_window_ready
    bool is_pivot_high = high[swingLookback] == ta.highest(high, 2 * swingLookback + 1)
    bool is_pivot_low  = low[swingLookback]  == ta.lowest(low, 2 * swingLookback + 1)

    if is_pivot_high
        if not na(last_swing_high)
            prev_swing_high := last_swing_high
            prev_swing_high_bar := last_swing_high_bar
        last_swing_high := high[swingLookback]
        last_swing_high_bar := bar_index - swingLookback

    if is_pivot_low
        if not na(last_swing_low)
            prev_swing_low := last_swing_low
            prev_swing_low_bar := last_swing_low_bar
        last_swing_low := low[swingLookback]
        last_swing_low_bar := bar_index - swingLookback

// Structure classification — a pure read of already-confirmed swing
// state, so it carries no additional repaint risk beyond the swing
// confirmation delay documented above.
bool structure_bullish = not na(prev_swing_high) and not na(prev_swing_low) and
     last_swing_high > prev_swing_high and last_swing_low > prev_swing_low
bool structure_bearish = not na(prev_swing_high) and not na(prev_swing_low) and
     last_swing_high < prev_swing_high and last_swing_low < prev_swing_low
bool structure_neutral = not structure_bullish and not structure_bearish

//======================================================================
// STATE 1: TREND QUALIFICATION
//======================================================================
// A trend qualifies as "worth unwinding" only once ALL of: structure has
// held for trendMinBars bars, the EMA cascade agrees, price is on the
// correct side of the RTH-anchored VWAP, ADX confirms trend strength, and
// the session has extended far enough (daily-ATR units) to give the
// eventual break something to retrace into. Bearish setup = a qualifying
// UPTREND (structure_bullish) that may break down; bullish setup mirrors
// it off structure_bearish. trend_qualified_bear/bull are independent
// latches, not forced mutually exclusive here — structure_bullish and
// structure_bearish already can't both be true on the same bar, which
// makes simultaneous qualification rare, but the two latches CAN persist
// through each other's failure window (10 bars) in principle. Rule 8
// ("one direction at a time") is enforced where it actually applies —
// Phase 3's break-arming — not at this eligibility stage.

// Consecutive-bar streak of the underlying structure classification,
// used to test the trendMinBars requirement. Self-referencing series
// (reads its own previous-bar value via [1]); resets to 0 the instant
// structure_bullish/bearish goes false, so no stale streak lingers once
// structure flips.
var int bull_structure_streak = 0
var int bear_structure_streak = 0
bull_structure_streak := structure_bullish ? bull_structure_streak + 1 : 0
bear_structure_streak := structure_bearish ? bear_structure_streak + 1 : 0

// Session extension, in daily-ATR units, for each candidate direction.
float bear_trend_extension_atr = (not na(atr_daily) and atr_daily > 0 and not na(session_open_price) and not na(session_high)) ?
     (session_high - session_open_price) / atr_daily : 0.0
float bull_trend_extension_atr = (not na(atr_daily) and atr_daily > 0 and not na(session_open_price) and not na(session_low)) ?
     (session_open_price - session_low) / atr_daily : 0.0

bool bear_setup_conditions = bull_structure_streak >= trendMinBars and ema9 > ema20 and ema20 > ema50 and
     close > anchored_vwap and adx >= adx_trend_min and bear_trend_extension_atr >= ext_min

bool bull_setup_conditions = bear_structure_streak >= trendMinBars and ema9 < ema20 and ema20 < ema50 and
     close < anchored_vwap and adx >= adx_trend_min and bull_trend_extension_atr >= ext_min

var bool trend_qualified_bear = false
var bool trend_qualified_bull = false
var int  bear_qualified_since_bar = na
var int  bull_qualified_since_bar = na
var int  bear_qualify_fail_streak = 0
var int  bull_qualify_fail_streak = 0

// (c) Session rollover — qualification does not carry across sessions;
// the extension and VWAP anchors it depends on just reset to zero.
if is_new_range
    trend_qualified_bear := false
    trend_qualified_bull := false
    bear_qualified_since_bar := na
    bull_qualified_since_bar := na
    bear_qualify_fail_streak := 0
    bull_qualify_fail_streak := 0

// Bear-setup (uptrend) qualification latch
if not trend_qualified_bear and bear_setup_conditions
    trend_qualified_bear := true
    bear_qualified_since_bar := bar_index
    bear_qualify_fail_streak := 0
else if trend_qualified_bear
    if bear_setup_conditions
        bear_qualify_fail_streak := 0
    else
        bear_qualify_fail_streak += 1
        // (b) 10 consecutive bars failing the qualifying conditions -> reset
        if bear_qualify_fail_streak >= 10
            trend_qualified_bear := false
            bear_qualified_since_bar := na
            bear_qualify_fail_streak := 0

// Bull-setup (downtrend) qualification latch — mirror of the above
if not trend_qualified_bull and bull_setup_conditions
    trend_qualified_bull := true
    bull_qualified_since_bar := bar_index
    bull_qualify_fail_streak := 0
else if trend_qualified_bull
    if bull_setup_conditions
        bull_qualify_fail_streak := 0
    else
        bull_qualify_fail_streak += 1
        if bull_qualify_fail_streak >= 10
            trend_qualified_bull := false
            bull_qualified_since_bar := na
            bull_qualify_fail_streak := 0

//======================================================================
// STATE 2: BREAK DETECTION
//======================================================================
// From a qualified trend, a break requires ALL FOUR: the prior confirmed
// swing is violated (close or wick, per requireCloseBreak), price closes
// beyond both ema20 and the RTH-anchored VWAP, volume expands past
// rvol_break, and the bar's range is violent enough (atr_break_mult x
// ATR). Conditions 1 (structure) and 3 (volume) are the discriminators
// that separate a real break from an ordinary pullback — per the
// calibration notes, real breaks take out the prior swing low/high on
// expanding volume; pullbacks in a healthy trend never do. Arming does
// NOT fire a signal — that's Phase 4 (CONFIRM). Every arm/cancel
// decision is gated by barstate.isconfirmed, so nothing here is made on
// an unconfirmed (still-forming) bar.
var bool  break_armed_bear = false
var int   break_bar_index_bear = na
var float break_bar_high_bear = na   // invalidation reference: a reclaim above this cancels the arm
var float break_extreme_bear = na    // session_high at break time, for retracement math (Phase 4)

var bool  break_armed_bull = false
var int   break_bar_index_bull = na
var float break_bar_low_bull = na    // invalidation reference: a reclaim below this cancels the arm
var float break_extreme_bull = na    // session_low at break time, for retracement math (Phase 4)

bool bear_break_trigger = trend_qualified_bear and not na(last_swing_low) and
     (requireCloseBreak ? close < last_swing_low : low < last_swing_low) and
     close < ema20 and close < anchored_vwap and
     rel_vol >= rvol_break and
     (high - low) >= atr * atr_break_mult

bool bull_break_trigger = trend_qualified_bull and not na(last_swing_high) and
     (requireCloseBreak ? close > last_swing_high : high > last_swing_high) and
     close > ema20 and close > anchored_vwap and
     rel_vol >= rvol_break and
     (high - low) >= atr * atr_break_mult

bool bear_break_armed_now = false
bool bull_break_armed_now = false

if barstate.isconfirmed
    // Session ends — cancel any still-armed break from the prior session.
    if is_new_range
        break_armed_bear := false
        break_bar_index_bear := na
        break_bar_high_bear := na
        break_extreme_bear := na
        break_armed_bull := false
        break_bar_index_bull := na
        break_bar_low_bull := na
        break_extreme_bull := na

    // Bearish break (from a qualified uptrend)
    if not break_armed_bear and bear_break_trigger
        break_armed_bear := true
        break_bar_index_bear := bar_index
        break_bar_high_bear := high
        break_extreme_bear := session_high
        bear_break_armed_now := true
        // Rule 8: arming one direction cancels the other
        break_armed_bull := false
        break_bar_index_bull := na
        break_bar_low_bull := na
        break_extreme_bull := na
    else if break_armed_bear
        bool cancel_bear_time = (bar_index - break_bar_index_bear) > confirmMaxBars
        bool cancel_bear_reclaim = close > break_bar_high_bear
        // (b)/(a) Consolidation-timeout or a reclaim back above the break
        // bar's high both mean the break failed — the trend is resuming,
        // not reversing.
        if cancel_bear_time or cancel_bear_reclaim
            break_armed_bear := false
            break_bar_index_bear := na
            break_bar_high_bear := na
            break_extreme_bear := na

    // Bullish break (from a qualified downtrend) — mirror of the above
    if not break_armed_bull and bull_break_trigger
        break_armed_bull := true
        break_bar_index_bull := bar_index
        break_bar_low_bull := low
        break_extreme_bull := session_low
        bull_break_armed_now := true
        break_armed_bear := false
        break_bar_index_bear := na
        break_bar_high_bear := na
        break_extreme_bear := na
    else if break_armed_bull
        bool cancel_bull_time = (bar_index - break_bar_index_bull) > confirmMaxBars
        bool cancel_bull_reclaim = close < break_bar_low_bull
        if cancel_bull_time or cancel_bull_reclaim
            break_armed_bull := false
            break_bar_index_bull := na
            break_bar_low_bull := na
            break_extreme_bull := na

//======================================================================
// VETOES
//======================================================================
// On a strong trend day, State 1-4 would otherwise fire repeatedly into
// a continuing move — these are what make the system survivable.
// bear_vetoed/bull_vetoed (consumed by the confirmation test below) fold
// in Vetoes 1-3. Veto 4 (consolidation cancel) needs no code here — it's
// already enforced by Phase 3's confirmMaxBars cancellation
// (cancel_bear_time/cancel_bull_time).

// Veto 1: Trend-Day Lockout — a session-level latch. Once tripped for a
// direction it holds for the rest of the session no matter what price
// does afterward; it does not un-trip mid-session, only at is_new_range.
var bool bear_locked_out = false
var bool bull_locked_out = false

if is_new_range
    bear_locked_out := false
    bull_locked_out := false

if useTrendDayLockout and barstate.isconfirmed and session_range > 0 and atr_daily > 0
    bool trend_day_range = (session_range / atr_daily) > 1.5
    bool close_top20 = (close - session_low) / session_range >= 0.8
    bool close_bottom20 = (close - session_low) / session_range <= 0.2
    bool adx_strong_rising = adx > 30 and adx_rising_3

    if trend_day_range and close_top20 and adx_strong_rising
        bear_locked_out := true
    if trend_day_range and close_bottom20 and adx_strong_rising
        bull_locked_out := true

// Veto 2: HTF Veto — a hard veto, not a score penalty (ICARUS has no
// scoring system to penalize in the first place). request.security is
// called unconditionally every bar per Pine convention; useHtfVeto only
// gates whether the result is allowed to block a signal.
[htf_ema9, htf_ema20, htf_close] = request.security(syminfo.tickerid, htfTimeframe,
     [ta.ema(close, 9), ta.ema(close, 20), close], lookahead = barmerge.lookahead_off)

bool htf_bullish = htf_ema9 > htf_ema20 and htf_close > htf_ema20
bool htf_bearish = htf_ema9 < htf_ema20 and htf_close < htf_ema20

bool htf_veto_sell = useHtfVeto and htf_bullish
bool htf_veto_buy = useHtfVeto and htf_bearish

// Veto 3: Time-of-Day Gates — hardcoded to ET (0930-1600:23456), the same
// window used throughout. Inappropriate for crypto / 24h futures without
// disabling useTimeGates — see ICARUS_CLAUDE.md.
int et_minutes = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
int minutes_since_open = et_minutes - (9 * 60 + 30)
int minutes_to_close = (16 * 60) - et_minutes
bool time_gate_veto = useTimeGates and rth_active and
     (minutes_since_open < noEntryOpenMins or minutes_to_close < noEntryCloseMins)

bool bear_vetoed = (useTrendDayLockout and bear_locked_out) or htf_veto_sell or time_gate_veto
bool bull_vetoed = (useTrendDayLockout and bull_locked_out) or htf_veto_buy or time_gate_veto

//======================================================================
// STATE 3: CONFIRMATION AND SIGNAL
//======================================================================
// From an armed break, confirmation requires a failed bounce: at least
// one green-closing bar since the break (the "bounce"), whose peak stays
// below the break bar's high — tracked explicitly here rather than
// relying on the arm's own invalidation check, because that check only
// cancels on a CLOSE reclaim (Phase 3), so an intrabar wick above
// break_bar_high wouldn't have cancelled the arm but would still fail
// this "lower high" test — followed by a red bar that closes below the
// low of the bar that set that peak. This costs ~0.3-0.5% of the move
// versus firing on the break itself, deliberately (rule 3) — it's what
// prevents "the knife was actually a flag" losses. Mirror for bullish.
var float bounce_high_bear = na        // peak high of any green-closing bar since the break
var float bounce_peak_low_bear = na    // low of the bar that set that peak
var bool  bounce_occurred_bear = false

var float bounce_low_bull = na         // trough low of any red-closing bar since the break
var float bounce_trough_high_bull = na // high of the bar that set that trough
var bool  bounce_occurred_bull = false

// bear_vetoed/bull_vetoed are computed in the VETOES section above.

// Strict alternation, reusing SuperLazyTrade's b_fired/s_fired pattern:
// a same-direction signal is blocked until the opposite one fires. Phase
// 6 will extend the clearing conditions to target/stop/time-stop exits
// (per the spec's "position is closed" list) — for now only the opposite
// signal firing, or session end, clears the guard.
var bool  b_fired = false
var bool  s_fired = false
var float entry_price_bear = na
var float invalidation_bear = na
var float entry_price_bull = na
var float invalidation_bull = na

bool signal_buy = false
bool signal_sell = false

if barstate.isconfirmed
    // Session end — force the alternation guard open for a fresh entry
    // next session (Phase 6 owns the actual position-close bookkeeping).
    if is_new_range
        b_fired := false
        s_fired := false

    bool bar_green = close > open
    bool bar_red = close < open

    if break_armed_bear
        if bear_break_armed_now
            // Fresh arm this bar — clear any stale bounce state left over
            // from a prior (cancelled) armed episode.
            bounce_high_bear := na
            bounce_peak_low_bear := na
            bounce_occurred_bear := false
        else if bar_green
            bounce_occurred_bear := true
            if na(bounce_high_bear) or high > bounce_high_bear
                bounce_high_bear := high
                bounce_peak_low_bear := low
        else if bar_red and bounce_occurred_bear and not na(bounce_peak_low_bear)
            bool bars_ok_bear = (bar_index - break_bar_index_bear) <= confirmMaxBars
            bool lower_high_bear = bounce_high_bear < break_bar_high_bear
            bool closes_below_bounce_low_bear = close < bounce_peak_low_bear
            float retrace_depth_bear = session_range > 0 ? (session_high - close) / session_range : na
            bool retrace_ok_bear = not na(retrace_depth_bear) and retrace_depth_bear >= retrace_min and retrace_depth_bear <= retrace_max

            if bars_ok_bear and lower_high_bear and closes_below_bounce_low_bear and retrace_ok_bear and not bear_vetoed and not s_fired
                signal_sell := true
                entry_price_bear := close
                invalidation_bear := bounce_high_bear
                s_fired := true
                b_fired := false
                break_armed_bear := false
                break_bar_index_bear := na
                break_bar_high_bear := na
                break_extreme_bear := na
                bounce_high_bear := na
                bounce_peak_low_bear := na
                bounce_occurred_bear := false

    if break_armed_bull
        if bull_break_armed_now
            bounce_low_bull := na
            bounce_trough_high_bull := na
            bounce_occurred_bull := false
        else if bar_red
            bounce_occurred_bull := true
            if na(bounce_low_bull) or low < bounce_low_bull
                bounce_low_bull := low
                bounce_trough_high_bull := high
        else if bar_green and bounce_occurred_bull and not na(bounce_trough_high_bull)
            bool bars_ok_bull = (bar_index - break_bar_index_bull) <= confirmMaxBars
            bool higher_low_bull = bounce_low_bull > break_bar_low_bull
            bool closes_above_bounce_high_bull = close > bounce_trough_high_bull
            float retrace_depth_bull = session_range > 0 ? (close - session_low) / session_range : na
            bool retrace_ok_bull = not na(retrace_depth_bull) and retrace_depth_bull >= retrace_min and retrace_depth_bull <= retrace_max

            if bars_ok_bull and higher_low_bull and closes_above_bounce_high_bull and retrace_ok_bull and not bull_vetoed and not b_fired
                signal_buy := true
                entry_price_bull := close
                invalidation_bull := bounce_low_bull
                b_fired := true
                s_fired := false
                break_armed_bull := false
                break_bar_index_bull := na
                break_bar_low_bull := na
                break_extreme_bull := na
                bounce_low_bull := na
                bounce_trough_high_bull := na
                bounce_occurred_bull := false

//======================================================================
// ATR BRACKET EXITS AND R-MULTIPLE TRACKING
//======================================================================
// Structural exits, not fixed-percentage: the stop sits beyond the
// failed bounce (Phase 4's invalidation reference), Target 1 is VWAP at
// entry (the reversion magnet), Target 2 is per target2Mode. All bracket
// levels are computed once, at entry, and held fixed thereafter — a
// bracket, not a trailing stop; "EMA50" mode is read at entry like the
// other two modes, for the same reason (see ICARUS_CLAUDE.md). Exit type
// is whichever of STOP/T1/T2/TIME touches first, checked in that
// priority order — STOP first because an indicator can't know intrabar
// sequencing, so a bar that could have hit both stop and a target is
// conservatively assumed to have hit the stop.
var bool  in_position_bear = false
var float stop_bear = na
var float target1_bear = na
var float target2_bear = na
var float risk_bear = na
var bool  stop_floored_bear = false
var int   entry_bar_bear = na

var bool  in_position_bull = false
var float stop_bull = na
var float target1_bull = na
var float target2_bull = na
var float risk_bull = na
var bool  stop_floored_bull = false
var int   entry_bar_bull = na

var array<float> trade_r_results_long = array.new<float>()
var array<float> trade_r_results_short = array.new<float>()

add_r_result(array<float> arr, float r, int max_size) =>
    array.push(arr, r)
    if array.size(arr) > max_size
        array.shift(arr)
    arr

bool exit_stop_bear = false
bool exit_t1_bear = false
bool exit_t2_bear = false
bool exit_time_bear = false

bool exit_stop_bull = false
bool exit_t1_bull = false
bool exit_t2_bull = false
bool exit_time_bull = false

if barstate.isconfirmed
    // --- Entry: set the bracket once, at the confirmation bar ---
    if signal_sell
        float raw_stop_bear = invalidation_bear + atr * stopAtrMult
        float raw_distance_bear = raw_stop_bear - entry_price_bear
        float floor_distance_bear = minTickStop > 0 ? minTickStop * syminfo.mintick : na
        bool floor_needed_bear = minTickStop > 0 and raw_distance_bear < floor_distance_bear
        stop_bear := floor_needed_bear ? entry_price_bear + floor_distance_bear : raw_stop_bear
        stop_floored_bear := floor_needed_bear
        risk_bear := stop_bear - entry_price_bear
        target1_bear := anchored_vwap
        target2_bear := target2Mode == "Session Open" ? session_open_price :
             target2Mode == "EMA50" ? ema50 :
             entry_price_bear - (target2R * risk_bear)
        entry_bar_bear := bar_index
        in_position_bear := true

    if signal_buy
        float raw_stop_bull = invalidation_bull - atr * stopAtrMult
        float raw_distance_bull = entry_price_bull - raw_stop_bull
        float floor_distance_bull = minTickStop > 0 ? minTickStop * syminfo.mintick : na
        bool floor_needed_bull = minTickStop > 0 and raw_distance_bull < floor_distance_bull
        stop_bull := floor_needed_bull ? entry_price_bull - floor_distance_bull : raw_stop_bull
        stop_floored_bull := floor_needed_bull
        risk_bull := entry_price_bull - stop_bull
        target1_bull := anchored_vwap
        target2_bull := target2Mode == "Session Open" ? session_open_price :
             target2Mode == "EMA50" ? ema50 :
             entry_price_bull + (target2R * risk_bull)
        entry_bar_bull := bar_index
        in_position_bull := true

    // --- Exit: SHORT position ---
    if in_position_bear and not signal_sell
        if high >= stop_bear
            exit_stop_bear := true
        else if low <= target1_bear
            exit_t1_bear := true
        else if not na(target2_bear) and low <= target2_bear
            exit_t2_bear := true
        else if (bar_index - entry_bar_bear) >= timeStopBars
            exit_time_bear := true

        if exit_stop_bear or exit_t1_bear or exit_t2_bear or exit_time_bear
            float exit_price_bear = exit_stop_bear ? stop_bear : exit_t1_bear ? target1_bear : exit_t2_bear ? target2_bear : close
            float realized_r_bear = risk_bear > 0 ? (entry_price_bear - exit_price_bear) / risk_bear : na
            trade_r_results_short := add_r_result(trade_r_results_short, realized_r_bear, 50)
            in_position_bear := false
            // Position closed — reopen the alternation guard for a fresh SELL.
            s_fired := false

    // --- Exit: LONG position (mirror) ---
    if in_position_bull and not signal_buy
        if low <= stop_bull
            exit_stop_bull := true
        else if high >= target1_bull
            exit_t1_bull := true
        else if not na(target2_bull) and high >= target2_bull
            exit_t2_bull := true
        else if (bar_index - entry_bar_bull) >= timeStopBars
            exit_time_bull := true

        if exit_stop_bull or exit_t1_bull or exit_t2_bull or exit_time_bull
            float exit_price_bull = exit_stop_bull ? stop_bull : exit_t1_bull ? target1_bull : exit_t2_bull ? target2_bull : close
            float realized_r_bull = risk_bull > 0 ? (exit_price_bull - entry_price_bull) / risk_bull : na
            trade_r_results_long := add_r_result(trade_r_results_long, realized_r_bull, 50)
            in_position_bull := false
            b_fired := false

// R-multiple stats — Avg R is the headline metric (== expectancy); win
// rate is tracked but deliberately secondary (a 42% system at 3:1 beats
// a 60% system at 1:1, and a win-rate number alone can't tell them apart).
calc_r_stats(array<float> arr) =>
    int total = array.size(arr)
    float sum_r = 0.0
    int wins = 0
    if total > 0
        for i = 0 to total - 1
            float r = array.get(arr, i)
            sum_r += r
            if r > 0
                wins += 1
    float avg_r = total > 0 ? sum_r / total : na
    float win_rate = total > 0 ? (wins / total) * 100 : na
    [avg_r, total, win_rate]

[avg_r_long, total_long, win_rate_long] = calc_r_stats(trade_r_results_long)
[avg_r_short, total_short, win_rate_short] = calc_r_stats(trade_r_results_short)

//======================================================================
// VISUALS (SCAFFOLD)
//======================================================================
plot(anchored_vwap, "Anchored VWAP", color = color.new(color.blue, 40), linewidth = 1)
plot(showLevels ? last_swing_high : na, "Last Swing High", color = color.new(color.orange, 0), style = plot.style_stepline, linewidth = 1)
plot(showLevels ? last_swing_low : na, "Last Swing Low", color = color.new(color.aqua, 0), style = plot.style_stepline, linewidth = 1)

// TEMP DEBUG: pipeline-stage visibility while chasing "no signals ever".
// Remove once the stall point is identified.
bgcolor(trend_qualified_bear ? color.new(color.red, 85) : trend_qualified_bull ? color.new(color.lime, 85) : na, title = "DEBUG: Trend Qualified")
plotchar(structure_bearish, title = "DEBUG: Structure Bearish", char = "▼", location = location.top, size = size.tiny, color = color.red)
plotchar(structure_bullish, title = "DEBUG: Structure Bullish", char = "▲", location = location.top, size = size.tiny, color = color.lime)
plotchar(bear_break_trigger, title = "DEBUG: Bear Break Trigger", char = "B", location = location.top, size = size.tiny, color = color.orange)
plotchar(bull_break_trigger, title = "DEBUG: Bull Break Trigger", char = "B", location = location.top, size = size.tiny, color = color.aqua)

// Break-armed markers — deliberately a small plotshape, distinct from the
// SELL/SNAPBACK label.new signal markers below.
plotshape(showState and bear_break_armed_now, title = "Bear Break Armed",
     style = shape.xcross, location = location.abovebar, size = size.tiny, color = color.new(color.orange, 0))
plotshape(showState and bull_break_armed_now, title = "Bull Break Armed",
     style = shape.xcross, location = location.belowbar, size = size.tiny, color = color.new(color.aqua, 0))

// Confirmation signal labels. Per spec: SELL below the bar, BUY above —
// note this is the inverse of the usual SELL-above/BUY-below convention;
// implemented exactly as specified rather than "corrected."
if signal_sell
    label.new(bar_index, na, "SELL ⚡ UNWIND", yloc = yloc.belowbar,
         style = label.style_label_up, color = color.red, textcolor = color.white, size = size.normal)

if signal_buy
    label.new(bar_index, na, "BUY ⚡ SNAPBACK", yloc = yloc.abovebar,
         style = label.style_label_down, color = color.green, textcolor = color.white, size = size.normal)

// Exit event labels — one per exit type, at the level that triggered it.
if exit_stop_bear
    label.new(bar_index, stop_bear, "STOP", yloc = yloc.price, style = label.style_label_down, color = color.new(color.maroon, 0), textcolor = color.white, size = size.small)
if exit_t1_bear
    label.new(bar_index, target1_bear, "T1", yloc = yloc.price, style = label.style_label_down, color = color.new(color.teal, 0), textcolor = color.white, size = size.small)
if exit_t2_bear
    label.new(bar_index, target2_bear, "T2", yloc = yloc.price, style = label.style_label_down, color = color.new(color.teal, 0), textcolor = color.white, size = size.small)
if exit_time_bear
    label.new(bar_index, close, "TIME", yloc = yloc.price, style = label.style_label_down, color = color.new(color.gray, 0), textcolor = color.white, size = size.small)

if exit_stop_bull
    label.new(bar_index, stop_bull, "STOP", yloc = yloc.price, style = label.style_label_up, color = color.new(color.maroon, 0), textcolor = color.white, size = size.small)
if exit_t1_bull
    label.new(bar_index, target1_bull, "T1", yloc = yloc.price, style = label.style_label_up, color = color.new(color.teal, 0), textcolor = color.white, size = size.small)
if exit_t2_bull
    label.new(bar_index, target2_bull, "T2", yloc = yloc.price, style = label.style_label_up, color = color.new(color.teal, 0), textcolor = color.white, size = size.small)
if exit_time_bull
    label.new(bar_index, close, "TIME", yloc = yloc.price, style = label.style_label_up, color = color.new(color.gray, 0), textcolor = color.white, size = size.small)

//======================================================================
// DASHBOARD
//======================================================================
// table.new at bottom_right, black bg, small text, left-aligned labels,
// merged header — matching SuperLazyTrade's visual style. Rendered only
// on barstate.islast. Row order follows the phase spec exactly (rows
// 1-8 base, 9-18 extended); see ICARUS_CLAUDE.md for the full layout
// and the worst-case row count.
if showDash and barstate.islast
    var table d = table.new(position.bottom_right, 2, DASHBOARD_MAX_ROWS,
         bgcolor = color.new(color.black, 0), border_width = 1)

    // Direction priority shared by several rows below: an open trade
    // outranks an armed break, which outranks a qualified trend, which
    // outranks nothing. In_position and break_armed are mutually
    // exclusive by construction (entering a trade clears the arm), so
    // this is a clean, non-overlapping chain rather than a tie-break.
    bool showing_bear = in_position_bear or break_armed_bear or trend_qualified_bear
    bool showing_bull = in_position_bull or break_armed_bull or trend_qualified_bull

    string header_state = in_position_bear or in_position_bull ? "IN TRADE" :
         break_armed_bear or break_armed_bull ? "ARMED" :
         trend_qualified_bear or trend_qualified_bull ? "TRENDING" :
         "UNQUALIFIED"

    // Row 1: Header
    string header_text = "ICARUS " + VERSION + " | " + header_state
    string fixed_header = header_text + str.substring(DASH_WIDTH, 0, math.max(0, 40 - str.length(header_text)))
    table.cell(d, 0, 0, fixed_header,
         text_color = color.white,
         bgcolor = color.new(color.gray, 40),
         text_size = size.small,
         text_halign = text.align_center)
    table.merge_cells(d, 0, 0, 1, 0)

    int row = 1

    // Row 2: Profile
    table.cell(d, 0, row, "Profile", text_color = color.white, text_halign = text.align_left, text_size = size.small)
    table.cell(d, 1, row, profile_name, text_color = color.white, text_size = size.small)
    row += 1

    // Row 3: State — IN TRADE > ARMED > TRENDING > UNQUALIFIED. No arrow
    // on ARMED/IN TRADE (direction conveyed by color only); the TRENDING
    // arrow shows the underlying trend direction being watched (↑ =
    // uptrend, watching for a bearish unwind; ↓ = downtrend, watching for
    // a bullish snapback). Where both bear/bull latches could
    // theoretically be true at once, bear takes display priority — a
    // deterministic tie-break, not expected in normal operation.
    string icarus_state = in_position_bear ? "🎯 IN TRADE (SELL)" :
         in_position_bull ? "🎯 IN TRADE (BUY)" :
         break_armed_bear ? "⚡ ARMED (bar " + str.tostring(bar_index - break_bar_index_bear) + "/" + str.tostring(confirmMaxBars) + ")" :
         break_armed_bull ? "⚡ ARMED (bar " + str.tostring(bar_index - break_bar_index_bull) + "/" + str.tostring(confirmMaxBars) + ")" :
         trend_qualified_bear ? "TRENDING ↑ (" + str.tostring(bear_trend_extension_atr, "#.#") + " ATR)" :
         trend_qualified_bull ? "TRENDING ↓ (" + str.tostring(bull_trend_extension_atr, "#.#") + " ATR)" :
         "UNQUALIFIED"
    color state_color = in_position_bear ? color.red : in_position_bull ? color.lime :
         break_armed_bear or break_armed_bull ? color.orange :
         trend_qualified_bear ? color.red : trend_qualified_bull ? color.lime : color.gray
    table.cell(d, 0, row, "State", text_color = color.white, text_halign = text.align_left, text_size = size.small)
    table.cell(d, 1, row, icarus_state, text_color = state_color, text_size = size.small)
    row += 1

    // Row 4: Extension — the active direction's session extension vs
    // ext_min. When nothing is active, falls back to whichever raw
    // extension (bear/bull) is larger, still useful for calibration.
    float active_extension = showing_bear ? bear_trend_extension_atr : showing_bull ? bull_trend_extension_atr :
         math.max(bear_trend_extension_atr, bull_trend_extension_atr)
    string extension_display = str.tostring(active_extension, "#.##") + " / " + str.tostring(ext_min, "#.#") + " ATR min"
    color extension_color = active_extension >= ext_min ? color.lime : color.gray
    table.cell(d, 0, row, "Extension", text_color = color.white, text_halign = text.align_left, text_size = size.small)
    table.cell(d, 1, row, extension_display, text_color = extension_color, text_size = size.small)
    row += 1

    // Row 5: Structure
    string structure_display = structure_bullish ? "HH/HL ↑" : structure_bearish ? "LH/LL ↓" : "NEUTRAL"
    table.cell(d, 0, row, "Structure", text_color = color.white, text_halign = text.align_left, text_size = size.small)
    table.cell(d, 1, row, structure_display, text_color = color.white, text_size = size.small)
    row += 1

    // Row 6: Retracement — only meaningful while a break is armed
    // (watching for confirmation); "—" otherwise.
    float retrace_depth_bear_live = session_range > 0 ? (session_high - close) / session_range : na
    float retrace_depth_bull_live = session_range > 0 ? (close - session_low) / session_range : na
    string retrace_display = ""
    color retrace_color = color.gray
    if break_armed_bear and not na(retrace_depth_bear_live)
        bool bear_in_window = retrace_depth_bear_live >= retrace_min and retrace_depth_bear_live <= retrace_max
        retrace_display := str.tostring(retrace_depth_bear_live * 100, "#.#") + "% " +
             (bear_in_window ? "✅ IN WINDOW" : retrace_depth_bear_live < retrace_min ? "⚠️ TOO SHALLOW" : "⚠️ TOO DEEP")
        retrace_color := bear_in_window ? color.lime : color.orange
    else if break_armed_bull and not na(retrace_depth_bull_live)
        bool bull_in_window = retrace_depth_bull_live >= retrace_min and retrace_depth_bull_live <= retrace_max
        retrace_display := str.tostring(retrace_depth_bull_live * 100, "#.#") + "% " +
             (bull_in_window ? "✅ IN WINDOW" : retrace_depth_bull_live < retrace_min ? "⚠️ TOO SHALLOW" : "⚠️ TOO DEEP")
        retrace_color := bull_in_window ? color.lime : color.orange
    else
        retrace_display := "—"
    table.cell(d, 0, row, "Retracement", text_color = color.white, text_halign = text.align_left, text_size = size.small)
    table.cell(d, 1, row, retrace_display, text_color = retrace_color, text_size = size.small)
    row += 1

    // Row 7: Vetoes — active veto names, direction-tagged where a veto
    // only blocks one side (Trend-Day Lockout, HTF); Time Gate blocks both.
    string veto_message = ""
    if useTrendDayLockout and bear_locked_out
        veto_message += "TREND-DAY LOCK (SELL) "
    if useTrendDayLockout and bull_locked_out
        veto_message += "TREND-DAY LOCK (BUY) "
    if htf_veto_sell
        veto_message += "HTF VETO (SELL) "
    if htf_veto_buy
        veto_message += "HTF VETO (BUY) "
    if time_gate_veto
        veto_message += "TIME GATE "

    string veto_display = veto_message == "" ? "NONE" : veto_message
    color veto_color = veto_message == "" ? color.new(color.gray, 40) : color.orange

    table.cell(d, 0, row, "Vetoes", text_color = veto_color, text_halign = text.align_left, text_size = size.small)
    table.cell(d, 1, row, veto_display, text_color = veto_color, text_size = size.small)
    row += 1

    // Row 8: Position — entry/stop/T1/T2/current R for the open trade, or
    // FLAT. ⚠FLOOR flags a stop widened by the minTickStop tick floor,
    // per Phase 6's explicit "flag it on the dashboard" requirement.
    float current_r_bear = in_position_bear and risk_bear > 0 ? (entry_price_bear - close) / risk_bear : na
    float current_r_bull = in_position_bull and risk_bull > 0 ? (close - entry_price_bull) / risk_bull : na
    string position_display = in_position_bear ?
         "SELL @ " + str.tostring(entry_price_bear, format.mintick) +
         " | SL " + str.tostring(stop_bear, format.mintick) + (stop_floored_bear ? " ⚠FLOOR" : "") +
         " | T1 " + str.tostring(target1_bear, format.mintick) +
         " | T2 " + str.tostring(target2_bear, format.mintick) +
         " | R " + str.tostring(current_r_bear, "+#.##;-#.##") :
         in_position_bull ?
         "BUY @ " + str.tostring(entry_price_bull, format.mintick) +
         " | SL " + str.tostring(stop_bull, format.mintick) + (stop_floored_bull ? " ⚠FLOOR" : "") +
         " | T1 " + str.tostring(target1_bull, format.mintick) +
         " | T2 " + str.tostring(target2_bull, format.mintick) +
         " | R " + str.tostring(current_r_bull, "+#.##;-#.##") :
         "FLAT"
    color position_color = in_position_bear ? color.red : in_position_bull ? color.lime : color.new(color.gray, 40)
    table.cell(d, 0, row, "Position", text_color = color.white, text_halign = text.align_left, text_size = size.small)
    table.cell(d, 1, row, position_display, text_color = position_color, text_size = size.small)
    row += 1

    if extDash
        // Row 9: separator
        table.cell(d, 0, row, "─────────────────────", text_color = color.new(color.gray, 60), text_size = size.small)
        table.merge_cells(d, 0, row, 1, row)
        row += 1

        // Row 10: Swing High / Swing Low levels
        string swing_display = (not na(last_swing_high) and not na(last_swing_low)) ?
             "H " + str.tostring(last_swing_high, format.mintick) + " / L " + str.tostring(last_swing_low, format.mintick) : "—"
        table.cell(d, 0, row, "Swing H/L", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
        table.cell(d, 1, row, swing_display, text_color = color.white, text_size = size.small)
        row += 1

        // Row 11: RVOL (with TOD / 20-bar / 20-bar* mode label, same as SuperLazyTrade)
        table.cell(d, 0, row, "RVOL", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
        table.cell(d, 1, row, str.tostring(rel_vol, "#.##") + "x " + rvol_mode_label, text_color = color.white, text_size = size.small)
        row += 1

        // Row 12: ADX + rising state
        string adx_display = str.tostring(adx, "#.#") + (adx_rising_3 ? " ↑ rising" : " flat/falling")
        table.cell(d, 0, row, "ADX", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
        table.cell(d, 1, row, adx_display, text_color = color.white, text_size = size.small)
        row += 1

        // Row 13: HTF bias
        string htf_bias_display = (htf_bullish ? "BULLISH" : htf_bearish ? "BEARISH" : "NEUTRAL") + " (" + htfTimeframe + ")"
        color htf_bias_color = htf_bullish ? color.lime : htf_bearish ? color.red : color.gray
        table.cell(d, 0, row, "HTF Bias", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
        table.cell(d, 1, row, htf_bias_display, text_color = htf_bias_color, text_size = size.small)
        row += 1

        // Row 14: Bars since break (when armed)
        string bars_since_break_display = break_armed_bear ? str.tostring(bar_index - break_bar_index_bear) + " / " + str.tostring(confirmMaxBars) :
             break_armed_bull ? str.tostring(bar_index - break_bar_index_bull) + " / " + str.tostring(confirmMaxBars) : "—"
        table.cell(d, 0, row, "Bars Since Break", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
        table.cell(d, 1, row, bars_since_break_display, text_color = color.white, text_size = size.small)
        row += 1

        // Row 15: separator
        table.cell(d, 0, row, "─────────────────────", text_color = color.new(color.gray, 60), text_size = size.small)
        table.merge_cells(d, 0, row, 1, row)
        row += 1

        // Row 16: Avg R — LONG (headline metric == expectancy)
        string avg_r_long_display = total_long > 0 ? str.tostring(avg_r_long, "+#.##;-#.##") + "R" : "—"
        color avg_r_long_color = na(avg_r_long) ? color.new(color.gray, 40) : avg_r_long >= 0 ? color.lime : color.red
        table.cell(d, 0, row, "Avg R — LONG", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
        table.cell(d, 1, row, avg_r_long_display, text_color = avg_r_long_color, text_size = size.small)
        row += 1

        // Row 17: Avg R — SHORT
        string avg_r_short_display = total_short > 0 ? str.tostring(avg_r_short, "+#.##;-#.##") + "R" : "—"
        color avg_r_short_color = na(avg_r_short) ? color.new(color.gray, 40) : avg_r_short >= 0 ? color.lime : color.red
        table.cell(d, 0, row, "Avg R — SHORT", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
        table.cell(d, 1, row, avg_r_short_display, text_color = avg_r_short_color, text_size = size.small)
        row += 1

        // Row 18: Trades / Win% — secondary line, both directions combined
        string trades_winrate_display = "L: " + str.tostring(total_long) +
             " (" + (total_long > 0 ? str.tostring(win_rate_long, "#.#") + "%" : "—") + ")" +
             " | S: " + str.tostring(total_short) +
             " (" + (total_short > 0 ? str.tostring(win_rate_short, "#.#") + "%" : "—") + ")"
        table.cell(d, 0, row, "Trades / Win%", text_color = color.new(color.gray, 20), text_halign = text.align_left, text_size = size.small)
        table.cell(d, 1, row, trades_winrate_display, text_color = color.new(color.gray, 20), text_size = size.small)
        row += 1

//======================================================================
// ALERTS
//======================================================================
// Static alertcondition entries (per spec: SELL, BUY, T1, T2, STOP — no
// separate TIME alertcondition, matching the phase spec's exact list).
// T1/T2/STOP OR the two directions together since either side touching
// that exit level is the same alertable event.
alertcondition(signal_sell, title = "SELL", message = "SELL")
alertcondition(signal_buy, title = "BUY", message = "BUY")
alertcondition(exit_t1_bear or exit_t1_bull, title = "T1", message = "T1")
alertcondition(exit_t2_bear or exit_t2_bull, title = "T2", message = "T2")
alertcondition(exit_stop_bear or exit_stop_bull, title = "STOP", message = "STOP")

// Dynamic alert() on entry — one multi-chart alert setup can drive every
// monitored symbol off this single call, since the message carries the
// ticker itself.
if signal_sell
    alert("ICARUS SELL " + syminfo.ticker + " | Entry " + str.tostring(entry_price_bear, format.mintick) +
         " | Stop " + str.tostring(stop_bear, format.mintick), alert.freq_once_per_bar_close)

if signal_buy
    alert("ICARUS BUY " + syminfo.ticker + " | Entry " + str.tostring(entry_price_bull, format.mintick) +
         " | Stop " + str.tostring(stop_bull, format.mintick), alert.freq_once_per_bar_close)
